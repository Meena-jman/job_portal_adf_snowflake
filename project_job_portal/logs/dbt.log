create or replace transient table JOB_PORTAL.Intermediate.intermediate_customer_churn
         as
        (WITH customer_churn_calculation
AS(
	SELECT
		customer_id,
		Customername,
		MAX(payment_month) AS last_payment_month
	FROM
		JOB_PORTAL.Intermediate.master_table
	GROUP BY
		customer_id,
		Customername
),
compare AS(
	SELECT
		*,
		DATEDIFF(month,last_payment_month,'2020-01-06') AS Churn_month_period,
		CASE 
			WHEN 
				DATEDIFF(month,last_payment_month,'2020-01-06')>3
			THEN
				'Customer_churn' 
			WHEN
				DATEDIFF(month,last_payment_month,'2020-01-06')=0
			THEN
				'Active_customer' 
			ELSE
				'Active_customer' 
			END
		 AS LT3_Churn,
		 DATEDIFF(year,last_payment_month,'2020-01-06') AS Churn_year_period,
		 CASE 
			WHEN 
				DATEDIFF(year,last_payment_month,'2020-01-06')>=1
			THEN
				'Customer_churn' 
			ELSE
				'Active_customer' 
			END
		 AS LTM_Churn
	FROM 
		customer_churn_calculation
),
final AS(
	SELECT 
		LT3_Churn,
		COUNT(LT3_Churn) AS LT3_Count,
		LTM_Churn,
		COUNT(LTM_Churn) AS LTM_Count
	FROM
		compare
	GROUP BY
		LT3_Churn,
		LTM_Churn
)

SELECT
	* 
FROM
	final


