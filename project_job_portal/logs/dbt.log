		FROM 
			customer_churn_calculation
		),
		churn AS(
			SELECT 
				*,
				CASE 
					WHEN 
						DATEDIFF(year,payment_month,CURRENT_DATE())>6
					THEN
						Customer_churn 
					ELSE
						Active_customer 
					END
				 AS Churn
			FROM 
				revenue_compute
			WHERE
				Order_history=1
        )
			
SELECT
    *
FROM
    churn
        );
