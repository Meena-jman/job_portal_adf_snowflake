create or replace transient table JOB_PORTAL.Intermediate.intermediate_customer_churn
         as
        (WITH customer_churn_calculation
AS(
        SELECT 
            customer_id,
            Customer_Name,
			SUM(revenue),
			payment_month
        FROM
           Customers
        GROUP BY
            customer_id,
            Customer_Name,
			payment_month
		
	),
	revenue_compute AS(
		SELECT 
			*,
			RANK() 
			OVER(PARTITION BY customer_id ORDER BY paymonth_month DESC) AS Order_history
		FROM 
			customer_churn_calculation
		),
		churn AS(
			SELECT 
				*,
				DATEDIFF(year,payment_month,SYSDATETIME) AS datediff
			FROM 
				revenue_compute
        )
			
SELECT
    *
FROM
    churn
