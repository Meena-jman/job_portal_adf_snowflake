WITH customer_churn_calculation
AS(
	SELECT
		customer_id,
		Customername,
		MAX(payment_month) AS last_payment_month
	FROM
		JOB_PORTAL.Intermediate.master_table
	GROUP BY
		customer_id,
		Customername
),
compare AS(
	SELECT
		*,
		DATEDIFF(day,last_payment_month,'2020-01-06') AS Churn_period,
		CASE 
			WHEN 
				DATEDIFF(day,last_payment_month,'2020-01-06')>30
			THEN
				'Customer_churn' 
			ELSE
				'Active_customer' 
			END
		 AS Churn
	FROM 
		customer_churn_calculation
)

SELECT
	* 
FROM
	compare


