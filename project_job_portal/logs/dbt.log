		CAST(quantity AS INT)   AS Quantity,
		CAST(companies AS varchar(50))	    AS Company
	FROM
		job_portal.raw.TRANSACTION1
	WHERE
		customer_id IS NOT NULL

)
SELECT 
	*
FROM
	transaction_data
        );
