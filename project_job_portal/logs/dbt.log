create or replace transient table JOB_PORTAL.Intermediate.intermediate_customer_churn
         as
        (WITH customer_churn_calculation
AS(
        SELECT 
            customer_id,
            Customername,
			SUM(revenue),
			payment_month
        FROM
           JOB_PORTAL.Intermediate.master_table
        GROUP BY
            customer_id,
            Customername,
			payment_month
	),
	revenue_compute AS(
		SELECT 
			*,
			RANK() 
			OVER(PARTITION BY customer_id ORDER BY payment_month DESC) AS Order_history
		FROM 
			customer_churn_calculation
		),
		churn AS(
			SELECT 
				*,
				CASE 
					WHEN 
						DATEDIFF(year,payment_month,CURRENT_DATE())>6
					THEN
						'Customer_churn' 
					ELSE
						'Active_customer' 
					END
				 AS Churn
			FROM 
				revenue_compute
			WHERE
				Order_history=1
        )
			
SELECT
    *
FROM
    churn
        );
