            customer.customer_id AS customer_id,
            customer.Customername AS customername,
            product_id,
            payment_month,
            revenue,
            Quantity,
            revenue_type
        FROM
            tablejoin1 AS join1
        INNER JOIN
           JOB_PORTAL.staging.stg_customer AS customer
        ON
            customer.customer_id=join1.customer_id
 )
SELECT
    *
FROM
    mastertable
        );
