create or replace transient table JOB_PORTAL.mart.mart_new_logos
         as
        (WITH new_customer AS (
    SELECT
        customer_id,
        customername,
        MIN(payment_month) AS first_order_date
    FROM
       JOB_PORTAL.Intermediate.master_table
    GROUP BY 
        customer_id,
        customername
)
