[0m14:07:02.567341 [debug] [Thread-1 (]: On model.project_job_portal.intermediate_customer_churn: /* {"app": "dbt", "dbt_version": "1.9.3", "profile_name": "project_job_portal", "target_name": "dev", "node_id": "model.project_job_portal.intermediate_customer_churn"} */
create or replace transient table JOB_PORTAL.Intermediate.intermediate_customer_churn
         as
        (WITH customer_churn_calculation
AS(
        SELECT 
            customer_id,
            Customername,
			payment_month
        FROM
           JOB_PORTAL.Intermediate.master_table
       
	),
	revenue_compute AS(
		SELECT 
			customer_id,
            Customername,
			payment_month,
			RANK() 
			OVER(PARTITION BY customer_id ORDER BY payment_month DESC) AS Order_history
		FROM 
			customer_churn_calculation
		GROUP BY
			customer_id,Customername,
			payment_month
		),
		churn AS(
			SELECT 
				*,
				DATEDIFF(year,payment_month,MAX(payment_month)) AS Churn_period,
				CASE 
					WHEN 
						DATEDIFF(year,payment_month,MAX(payment_month))>3
					THEN
						'Customer_churn' 
					ELSE
						'Active_customer' 
					END
				 AS Churn
			FROM 
				revenue_compute
			WHERE
				Order_history=1
        )
			
SELECT
    *
FROM
    churn
        );
