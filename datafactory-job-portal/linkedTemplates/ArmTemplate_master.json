{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "datafactory-job-portal"
		},
		"LS_BLOB_DB_TO_CSV_connectionString": {
			"type": "secureString",
			"metadata": "Secure string for 'connectionString' of 'LS_BLOB_DB_TO_CSV'"
		},
		"LS_SNOWFLAKE_JOB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SNOWFLAKE_JOB'"
		},
		"LS_SQL_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_DB'"
		},
		"LS_SQL_JOB_DB_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'LS_SQL_JOB_DB'"
		},
		"AzureBlobStorage1_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'AzureBlobStorage1'"
		},
		"LS_BLOB_TO_SNOWFLAKE_sasUri": {
			"type": "secureString",
			"metadata": "Secure string for 'sasUri' of 'LS_BLOB_TO_SNOWFLAKE'"
		},
		"LS_SNOWFLAKE_JOB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "JOB_PORTAL"
		},
		"LS_SNOWFLAKE_JOB_properties_typeProperties_role": {
			"type": "string",
			"defaultValue": "accountadmin"
		},
		"LS_SQL_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "JM-DKT-042"
		},
		"LS_SQL_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "job_portal_"
		},
		"LS_SQL_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "sa"
		},
		"LS_SQL_JOB_DB_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "JM-DKT-042"
		},
		"LS_SQL_JOB_DB_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "job_portal_"
		},
		"LS_SQL_JOB_DB_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "AzureAD\\MeenaK"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "datafactory-job-portal_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"LS_BLOB_DB_TO_CSV_connectionString": {
						"value": "[parameters('LS_BLOB_DB_TO_CSV_connectionString')]"
					},
					"LS_SNOWFLAKE_JOB_password": {
						"value": "[parameters('LS_SNOWFLAKE_JOB_password')]"
					},
					"LS_SQL_DB_password": {
						"value": "[parameters('LS_SQL_DB_password')]"
					},
					"LS_SQL_JOB_DB_password": {
						"value": "[parameters('LS_SQL_JOB_DB_password')]"
					},
					"AzureBlobStorage1_sasUri": {
						"value": "[parameters('AzureBlobStorage1_sasUri')]"
					},
					"LS_BLOB_TO_SNOWFLAKE_sasUri": {
						"value": "[parameters('LS_BLOB_TO_SNOWFLAKE_sasUri')]"
					},
					"LS_SNOWFLAKE_JOB_properties_typeProperties_database": {
						"value": "[parameters('LS_SNOWFLAKE_JOB_properties_typeProperties_database')]"
					},
					"LS_SNOWFLAKE_JOB_properties_typeProperties_role": {
						"value": "[parameters('LS_SNOWFLAKE_JOB_properties_typeProperties_role')]"
					},
					"LS_SQL_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_server')]"
					},
					"LS_SQL_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_database')]"
					},
					"LS_SQL_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_DB_properties_typeProperties_userName')]"
					},
					"LS_SQL_JOB_DB_properties_typeProperties_server": {
						"value": "[parameters('LS_SQL_JOB_DB_properties_typeProperties_server')]"
					},
					"LS_SQL_JOB_DB_properties_typeProperties_database": {
						"value": "[parameters('LS_SQL_JOB_DB_properties_typeProperties_database')]"
					},
					"LS_SQL_JOB_DB_properties_typeProperties_userName": {
						"value": "[parameters('LS_SQL_JOB_DB_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		}
	]
}